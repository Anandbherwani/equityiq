# ── Google Sheets Web App API ────────────────────────────────────────────────
# Server-side (used by Next.js API routes and SSR pages). Never exposed to the browser.
SHEETS_API_URL=

# Client-side fallback (exposed to browser via NEXT_PUBLIC_ prefix).
# Only set this if you need the browser to call the Sheets API directly.
NEXT_PUBLIC_SHEETS_API_URL=

# ── OpenRouter AI (free models) ──────────────────────────────────────────────
# Get your key at https://openrouter.ai/keys
# Used by /api/analyze route and ai-client.ts
# Model routing:
#   brief/summary   → google/gemini-2.0-flash-exp:free
#   scoring/reason  → deepseek/deepseek-r1:free
#   classification  → mistralai/mistral-7b-instruct:free
OPENROUTER_API_KEY=
