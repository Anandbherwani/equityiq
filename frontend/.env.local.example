# EquityIQ environment variables
# Every variable here is OPTIONAL — the app works with zero env vars set.
# Copy this file to .env.local and fill in only what you want.

# ── Google Sheets Web App API ─────────────────────────────────────────────────
# Optional — without this the app runs in demo/preview mode.
# Server-side only (never sent to the browser).
SHEETS_API_URL=

# Optional — allows browser to call Sheets API directly (bypasses Next.js proxy).
NEXT_PUBLIC_SHEETS_API_URL=

# ── AI providers — all optional, app works without any of them ────────────────
# The AI waterfall tries each provider in order and falls back to rule-based JS.

# Pollinations AI is always tried first — no key needed, no signup.
# https://text.pollinations.ai  (free, unlimited, no account)

# Groq — optional — 14,400 free req/day, no credit card
# https://console.groq.com/keys
GROQ_API_KEY=

# Google Gemini — optional — 1,500 free req/day
# https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# OpenRouter — optional — free models available (no credit card for free tier)
# https://openrouter.ai/keys
OPENROUTER_API_KEY=
